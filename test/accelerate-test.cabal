cabal-version: 2.4
name: accelerate-test
version: 0.1.0.0
build-type: Simple

executable accelerate-test
  main-is: Main.hs
  hs-source-dirs: src
  build-depends:
    accelerate,
    accelerate-llvm-native,
    base,

  default-language: Haskell2010
  ghc-options:
    -threaded
    -O2

test-suite ilp
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    ILP.Compare
    ILP.Programs
    ILP.Trafo
    ILP.Validate

  build-depends:
    accelerate,
    accelerate-llvm-native,
    base,
    containers,

  default-language: Haskell2010
  ghc-options: -threaded

executable ilp-bench
  main-is: Bench.hs
  hs-source-dirs:
    bench
    test

  other-modules:
    Baseline
    BinaryDefaults
    Custom
    Framework
    ILP.Programs
    ILP.Trafo
    ILP.Validate
    Lowering

  build-depends:
    accelerate,
    accelerate-llvm-native,
    base,
    containers,
    criterion-measurement,

  default-language: Haskell2010
  ghc-options:
    -threaded
    -O2
